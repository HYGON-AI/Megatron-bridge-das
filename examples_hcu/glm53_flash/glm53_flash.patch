+    def _experts_per_rank(self, num_experts: int) -> int:
+        expected = len(self.hf_param) // len(self._projections)
+        local_experts, remainder = divmod(num_experts, self.ep_size)
+        if num_experts != expected or not local_experts or remainder:
+            raise ValueError(
+                f"{self.megatron_param}: expected {expected} checkpoint experts, got "
+                f"{num_experts} model experts with EP size {self.ep_size}."
+            )
+        return local_experts
+
+    def hf_to_megatron(
+        self, hf_weights: Callable[[str], torch.Tensor], megatron_module: nn.Module
+    ) -> torch.Tensor:
+        """Load only this EP rank's experts, in global expert order."""
+        local_experts = self._experts_per_rank(megatron_module.config.num_moe_experts)
+        first_expert = self.ep_rank * local_experts
+        projections = self._projections
+        weights = []
+        for expert_id in range(first_expert, first_expert + local_experts):
+            parts = [hf_weights(self.hf_param[f"{projection}.{expert_id}"]) for projection in projections]
+            weights.append(torch.cat(parts, dim=0) if len(parts) > 1 else parts[0])
+        return torch.stack(weights)
+
+    def megatron_to_hf(
+        self, megatron_weights: torch.Tensor | None, megatron_module: nn.Module | None
+    ) -> dict[str, torch.Tensor]:
+        """Gather EP shards and emit the original HF projection names."""
+        local_weights = self.broadcast_from_pp_rank(megatron_weights, cache_key=self.megatron_param)
+        if local_weights is None:
+            return {}
+        local_weights = self.maybe_dequantize(local_weights)
+        self._experts_per_rank(local_weights.size(0) * self.ep_size)
+        shards = [local_weights]
+        if self.ep_size > 1:
+            shards = [torch.empty_like(local_weights) for _ in range(self.ep_size)]
+            torch.distributed.all_gather(shards, local_weights, group=self.ep_group)
+
+        projections = self._projections
+        weights = {}
+        for ep_rank, shard in enumerate(shards):
+            for local_index, expert_weight in enumerate(shard):
+                expert_id = ep_rank * local_weights.size(0) + local_index
+                for projection, weight in zip(projections, expert_weight.chunk(len(projections), dim=0), strict=True):
+                    weights[self.hf_param[f"{projection}.{expert_id}"]] = weight
+        return weights
+
