+def _mega_moe_layer_spec(spec: ModuleSpec) -> ModuleSpec:
+    """Swap the MoE layer in a TransformerLayer spec for the fused MegaMoE layer.
+
+    ``submodules.mlp`` is a ``functools.partial`` of ``MoELayer`` carrying the
+    ``MoESubmodules`` (router, experts, shared experts) built by Megatron Core.
+    MegaMoE reuses the router and shared-expert specs and replaces the routed
+    experts with the fused operator, so rebinding the partial's ``module`` to
+    ``PrimusTurboMegaMoELayer`` is enough.
+    """
+    import functools
+
+    from megatron.core.transformer.moe.moe_layer import MoELayer
+
