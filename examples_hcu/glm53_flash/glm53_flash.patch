+    # MegaMoE MXFP8 caches the quantized expert weights inside the fused operator.
+    # Advance the generation after the optimizer updates the bf16 master weights so
+    # the next forward re-quantizes them.
+    transformer_config = getattr(cfg.model, "transformer", None)
+    if (
+            update_successful
+            and transformer_config is not None
+            and getattr(transformer_config, "mega_moe", False)
+            and getattr(transformer_config, "turbo_mega_moe_precision", "bf16") == "mxfp8"
+    ):
+        from megatron.bridge.models.moe.mega_moe import advance_mega_moe_weight_generation
+
+        advance_mega_moe_weight_generation()
+
     # when freezing sub-models we may have a mixture of successful and unsucessful ranks,
     # so we must gather across mp ranks
     if train_config.check_optimizer_step_success:
