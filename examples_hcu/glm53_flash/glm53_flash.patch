+class _MegaMoEExpertMapping(MegatronParamMapping[Callable[[str], torch.Tensor]]):
+    """Convert per-expert HF projections to and from an EP-local weight tensor."""
+
+    def __init__(self, megatron_param: str, hf_param: dict[str, str]) -> None:
+        super().__init__(megatron_param, _MegaMoEHFParams(hf_param))
