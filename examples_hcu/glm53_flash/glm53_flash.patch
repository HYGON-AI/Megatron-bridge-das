+from megatron.bridge.training.config import ConfigContainer
+
+
+def glm53_flash_pretrain_16gpu_bw1300_bf16_test_config() -> ConfigContainer:
+    """GLM-5.3-Flash bounded pretraining on 16 BW1300 GPUs."""
+    cfg = glm53_flash_pretrain_16gpu_bw1101_bf16_test_config()
+    cfg.env_vars = {
+        **cfg.env_vars,
+        "DEEP_EP_NORMAL_MNVL": 1,
+    }
+    return cfg
+
+
+def glm53_flash_sft_16gpu_bw1300_bf16_test_config() -> ConfigContainer:
+    """GLM-5.3-Flash bounded SFT on 16 BW1300 GPUs."""
+    cfg = glm53_flash_sft_16gpu_bw1101_bf16_test_config()
+    cfg.env_vars = {
+        **cfg.env_vars,
+        "DEEP_EP_NORMAL_MNVL": 1,
+    }
+    return cfg
+
+
+def glm53_flash_peft_32gpu_bw1300_bf16_config() -> ConfigContainer:
+    """GLM-5.3-Flash PEFT on 32 BW1300 GPUs with the full 90-layer model."""
+    cfg = glm53_flash_peft_32gpu_bw1101_bf16_config()
+    cfg.env_vars = {
+        **cfg.env_vars,
+        "DEEP_EP_NORMAL_MNVL": 1,
+    }
+    return cfg
+
+
+__all__ = [
