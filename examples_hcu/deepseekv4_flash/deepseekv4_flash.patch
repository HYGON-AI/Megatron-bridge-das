+"""BW1101 recipe for DeepSeek-V4-Flash PEFT."""
+
+from __future__ import annotations
+
+import torch
+
+from megatron.bridge.models.deepseek.deepseek_v4_bridge import (
+    set_deepseek_v4_pipeline_model_parallel_layout,
+)
+from megatron.bridge.recipes.deepseek import (
+    deepseek_v4_flash_pretrain_64gpu_gb200_bf16_config,
+    deepseek_v4_flash_pretrain_64gpu_gb200_bf16_muon_config,
+    deepseek_v4_flash_sft_openmath_thinking_packed_gb200_config,
+    deepseek_v4_flash_peft_openmath_thinking_packed_gb200_config,
+)
+from megatron.bridge.training.config import ConfigContainer
+
+
+def _deepseek_v4_supports_bw_fused_kernels() -> bool:
+    """Return whether DSv4 BW-only fused kernels should default on."""
+    if not torch.cuda.is_available():
+        return False
+
+    major, _minor = torch.cuda.get_device_capability()
+    return major >= 9
+
+
+def deepseek_v4_flash_pretrain_32gpu_bw1101_bf16_test_config() -> ConfigContainer:
+    """Return the BW1101-optimized 16-layer pretrain test config."""
+    cfg = deepseek_v4_flash_pretrain_64gpu_gb200_bf16_config()
+    cfg.model.use_fused_mhc = _deepseek_v4_supports_bw_fused_kernels()
+    cfg.model.fine_grained_activation_offloading = False
+    cfg.env_vars.pop("NVTE_CPU_OFFLOAD_V1", None)
+    cfg.model.hybrid_layer_pattern = "WEWECEHECEHECEHE"
+    cfg.model.num_layers = 16
+    set_deepseek_v4_pipeline_model_parallel_layout(cfg.model)
+    return cfg
+
+
+def deepseek_v4_flash_pretrain_32gpu_bw1101_bf16_muon_test_config() -> ConfigContainer:
+    """Return the BW1101-optimized 16-layer pretrain test config."""
+    cfg = deepseek_v4_flash_pretrain_64gpu_gb200_bf16_muon_config()
+    cfg.model.use_fused_mhc = _deepseek_v4_supports_bw_fused_kernels()
+    cfg.model.fine_grained_activation_offloading = False
+    cfg.env_vars.pop("NVTE_CPU_OFFLOAD_V1", None)
+    cfg.model.hybrid_layer_pattern = "WEWECEHECEHECEHE"
+    cfg.model.num_layers = 16
+    set_deepseek_v4_pipeline_model_parallel_layout(cfg.model)
+    return cfg
+
+
+def deepseek_v4_flash_sft_32gpu_bw1101_bf16_test_config() -> ConfigContainer:
+    """Return the BW1101-optimized packed OpenMath SFT test config."""
+    cfg = deepseek_v4_flash_sft_openmath_thinking_packed_gb200_config()
+    cfg.model.use_fused_mhc = _deepseek_v4_supports_bw_fused_kernels()
+    cfg.model.fine_grained_activation_offloading = False
+    cfg.env_vars.pop("NVTE_CPU_OFFLOAD_V1", None)
+    cfg.model.hybrid_layer_pattern = "WEWECEHECEHECEHECEHECEHECEHECEHE"
+    cfg.model.num_layers = 32
+    set_deepseek_v4_pipeline_model_parallel_layout(cfg.model)
+    return cfg
+
+
+def deepseek_v4_flash_peft_32gpu_bw1101_bf16_config() -> ConfigContainer:
+    """Return the BW1101-optimized packed OpenMath LoRA config."""
+    cfg = deepseek_v4_flash_peft_openmath_thinking_packed_gb200_config()
+    cfg.model.use_fused_mhc = _deepseek_v4_supports_bw_fused_kernels()
+    return cfg
+
+
+__all__ = [
+    "deepseek_v4_flash_pretrain_32gpu_bw1101_bf16_test_config",
+    "deepseek_v4_flash_pretrain_32gpu_bw1101_bf16_muon_test_config",
+    "deepseek_v4_flash_sft_32gpu_bw1101_bf16_test_config",
+    "deepseek_v4_flash_peft_32gpu_bw1101_bf16_config",
+]
