+"""BW1101 recipe for DeepSeek-V4-Flash PEFT."""
+
+from __future__ import annotations
+
+import torch
+
+from megatron.bridge.recipes.deepseek import (
+    deepseek_v4_flash_peft_openmath_thinking_packed_gb200_config,
+)
+from megatron.bridge.training.config import ConfigContainer
+
+
+def _deepseek_v4_supports_bw_fused_kernels() -> bool:
+    """Return whether DSv4 BW-only fused kernels should default on."""
+    if not torch.cuda.is_available():
+        return False
+
+    major, _minor = torch.cuda.get_device_capability()
+    return major >= 9
+
+
+def deepseek_v4_flash_peft_32gpu_bw1101_bf16_config() -> ConfigContainer:
+    """Return the BW1101-optimized packed OpenMath LoRA config."""
+    cfg = deepseek_v4_flash_peft_openmath_thinking_packed_gb200_config()
+    cfg.model.use_fused_mhc = _deepseek_v4_supports_bw_fused_kernels()
+    return cfg
+
+
+__all__ = [
+    "deepseek_v4_flash_peft_32gpu_bw1101_bf16_config",
+]
